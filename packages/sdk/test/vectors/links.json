{
  "schema": "efs-sdk/vectors/links/1",
  "note": "The link grammar (tag model spec §5). `fold` names the fold step used: `none` (no fold given) or `ascii-test` (a stand-in for the tests only: lowercase A-Z and turn a run of spaces into one underscore; the real rule is efs/fold/1, still to be chosen). `expect` is the parse: status, then target and canonical, or rule, segment and detail. A `?lens=` parameter (1 to 64 principals, each once: a 20-byte address for an account, else a 32-byte principal id) is the only one defined, on every kind but revisions.",
  "cases": [
    {
      "label": "object link",
      "input": "~efs/o/0xabababababababababababababababababababababababababababababababab",
      "fold": "none",
      "expect": {
        "status": "OK",
        "target": {
          "kind": "object",
          "subject": "0xabababababababababababababababababababababababababababababababab"
        },
        "canonical": "~efs/o/0xabababababababababababababababababababababababababababababababab"
      }
    },
    {
      "label": "revision link",
      "input": "/~efs/v/0xCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCD",
      "fold": "none",
      "expect": {
        "status": "OK",
        "target": {
          "kind": "revision",
          "recordId": "0xcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd"
        },
        "canonical": "~efs/v/0xcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd"
      }
    },
    {
      "label": "other ~ segment is reserved",
      "input": "~tags/cars",
      "fold": "none",
      "expect": {
        "status": "INVALID",
        "rule": "reserved-name"
      }
    },
    {
      "label": "bare ~",
      "input": "~",
      "fold": "none",
      "expect": {
        "status": "INVALID",
        "rule": "reserved-name"
      }
    },
    {
      "label": "home root",
      "input": "0xAbCdEf0123456789aBcDeF0123456789AbCdEf01",
      "fold": "none",
      "expect": {
        "status": "OK",
        "target": {
          "kind": "home",
          "address": "0xabcdef0123456789abcdef0123456789abcdef01",
          "names": []
        },
        "canonical": "0xabcdef0123456789abcdef0123456789abcdef01"
      }
    },
    {
      "label": "home path keeps case",
      "input": "0xabcdef0123456789abcdef0123456789abcdef01/Photos/Cat.JPG",
      "fold": "ascii-test",
      "expect": {
        "status": "OK",
        "target": {
          "kind": "home",
          "address": "0xabcdef0123456789abcdef0123456789abcdef01",
          "names": ["Photos", "Cat.JPG"]
        },
        "canonical": "0xabcdef0123456789abcdef0123456789abcdef01/Photos/Cat.JPG"
      }
    },
    {
      "label": "home name with space, encoded",
      "input": "0xabcdef0123456789abcdef0123456789abcdef01/my%20photos",
      "fold": "none",
      "expect": {
        "status": "OK",
        "target": {
          "kind": "home",
          "address": "0xabcdef0123456789abcdef0123456789abcdef01",
          "names": ["my photos"]
        },
        "canonical": "0xabcdef0123456789abcdef0123456789abcdef01/my%20photos"
      }
    },
    {
      "label": "home name, unicode",
      "input": "0xabcdef0123456789abcdef0123456789abcdef01/日本",
      "fold": "none",
      "expect": {
        "status": "OK",
        "target": {
          "kind": "home",
          "address": "0xabcdef0123456789abcdef0123456789abcdef01",
          "names": ["日本"]
        },
        "canonical": "0xabcdef0123456789abcdef0123456789abcdef01/%E6%97%A5%E6%9C%AC"
      }
    },
    {
      "label": "home name .. refused",
      "input": "0xabcdef0123456789abcdef0123456789abcdef01/..",
      "fold": "none",
      "expect": {
        "status": "INVALID",
        "rule": "bad-name",
        "segment": 1,
        "detail": "dot-or-dotdot"
      }
    },
    {
      "label": "home name with escaped slash refused",
      "input": "0xabcdef0123456789abcdef0123456789abcdef01/a%2Fb",
      "fold": "none",
      "expect": {
        "status": "INVALID",
        "rule": "bad-name",
        "segment": 1,
        "detail": "excluded-character"
      }
    },
    {
      "label": "home with a Lens",
      "input": "0xabcdef0123456789abcdef0123456789abcdef01/photos?lens=0x1111111111111111111111111111111111111111,0x2222222222222222222222222222222222222222222222222222222222222222",
      "fold": "none",
      "expect": {
        "status": "OK",
        "target": {
          "kind": "home",
          "address": "0xabcdef0123456789abcdef0123456789abcdef01",
          "names": ["photos"],
          "lens": {
            "principals": [
              "0x0000000000000000000000001111111111111111111111111111111111111111",
              "0x2222222222222222222222222222222222222222222222222222222222222222"
            ]
          }
        },
        "canonical": "0xabcdef0123456789abcdef0123456789abcdef01/photos?lens=0x1111111111111111111111111111111111111111,0x2222222222222222222222222222222222222222222222222222222222222222"
      }
    },
    {
      "label": "topic, unfolded",
      "input": "Cars/Tesla",
      "fold": "none",
      "expect": {
        "status": "OK",
        "target": {
          "kind": "topic",
          "segments": ["Cars", "Tesla"]
        },
        "canonical": "Cars/Tesla"
      }
    },
    {
      "label": "topic, folded",
      "input": "Cars/Tesla",
      "fold": "ascii-test",
      "expect": {
        "status": "OK",
        "target": {
          "kind": "topic",
          "segments": ["Cars", "Tesla"],
          "words": ["cars", "tesla"]
        },
        "canonical": "cars/tesla"
      }
    },
    {
      "label": "word page",
      "input": "/tesla/",
      "fold": "ascii-test",
      "expect": {
        "status": "OK",
        "target": {
          "kind": "topic",
          "segments": ["tesla"],
          "words": ["tesla"]
        },
        "canonical": "tesla"
      }
    },
    {
      "label": "percent-decoded before folding",
      "input": "model%20Y",
      "fold": "ascii-test",
      "expect": {
        "status": "OK",
        "target": {
          "kind": "topic",
          "segments": ["model Y"],
          "words": ["model_y"]
        },
        "canonical": "model_y"
      }
    },
    {
      "label": "qualifier",
      "input": "space/mercury_(planet)",
      "fold": "ascii-test",
      "expect": {
        "status": "OK",
        "target": {
          "kind": "topic",
          "segments": ["space", "mercury_(planet)"],
          "words": ["space", "mercury_(planet)"]
        },
        "canonical": "space/mercury_%28planet%29"
      }
    },
    {
      "label": "escaped slash is not a separator, and a word can't hold one",
      "input": "cars%2Ftesla",
      "fold": "none",
      "expect": {
        "status": "INVALID",
        "rule": "bad-word",
        "segment": 0,
        "detail": "slash"
      }
    },
    {
      "label": "empty segment",
      "input": "cars//tesla",
      "fold": "none",
      "expect": {
        "status": "INVALID",
        "rule": "empty-segment"
      }
    },
    {
      "label": "dot word",
      "input": "cars/..",
      "fold": "none",
      "expect": {
        "status": "INVALID",
        "rule": "bad-word",
        "segment": 1,
        "detail": "dot"
      }
    },
    {
      "label": "later ~ word",
      "input": "cars/~x",
      "fold": "none",
      "expect": {
        "status": "INVALID",
        "rule": "bad-word",
        "segment": 1,
        "detail": "reserved-tilde"
      }
    },
    {
      "label": "address-shaped later word",
      "input": "people/0xabcdef0123456789abcdef0123456789abcdef01",
      "fold": "none",
      "expect": {
        "status": "INVALID",
        "rule": "bad-word",
        "segment": 1,
        "detail": "address-shaped"
      }
    },
    {
      "label": "uppercase 0X is not a home and not a word",
      "input": "0XABCDEF0123456789ABCDEF0123456789ABCDEF01",
      "fold": "none",
      "expect": {
        "status": "INVALID",
        "rule": "bad-word",
        "segment": 0,
        "detail": "address-shaped"
      }
    },
    {
      "label": "malformed escape",
      "input": "cars/%zz",
      "fold": "none",
      "expect": {
        "status": "INVALID",
        "rule": "bad-escape",
        "segment": 1
      }
    },
    {
      "label": "escape that is not UTF-8",
      "input": "cars/%FF",
      "fold": "none",
      "expect": {
        "status": "INVALID",
        "rule": "bad-escape",
        "segment": 1
      }
    },
    {
      "label": "word too long",
      "input": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "fold": "none",
      "expect": {
        "status": "INVALID",
        "rule": "bad-word",
        "segment": 0,
        "detail": "length"
      }
    },
    {
      "label": "topic with a Lens",
      "input": "Cars?lens=0x1111111111111111111111111111111111111111",
      "fold": "ascii-test",
      "expect": {
        "status": "OK",
        "target": {
          "kind": "topic",
          "segments": ["Cars"],
          "words": ["cars"],
          "lens": {
            "principals": ["0x0000000000000000000000001111111111111111111111111111111111111111"]
          }
        },
        "canonical": "cars?lens=0x1111111111111111111111111111111111111111"
      }
    },
    {
      "label": "the fold's own refusal",
      "input": "cars/te\u0000sla",
      "fold": "ascii-test",
      "expect": {
        "status": "INVALID",
        "rule": "bad-word",
        "segment": 1,
        "detail": "control"
      }
    },
    {
      "label": "fragment",
      "input": "cars#x",
      "fold": "none",
      "expect": {
        "status": "INVALID",
        "rule": "fragment"
      }
    },
    {
      "label": "topic with a Lens, unfolded",
      "input": "Cars?lens=0x1111111111111111111111111111111111111111",
      "fold": "none",
      "expect": {
        "status": "OK",
        "target": {
          "kind": "topic",
          "segments": ["Cars"],
          "lens": {
            "principals": ["0x0000000000000000000000001111111111111111111111111111111111111111"]
          }
        },
        "canonical": "Cars?lens=0x1111111111111111111111111111111111111111"
      }
    },
    {
      "label": "an unknown parameter is still refused",
      "input": "0xabcdef0123456789abcdef0123456789abcdef01/photos?view=all",
      "fold": "none",
      "expect": {
        "status": "INVALID",
        "rule": "unsupported-parameter"
      }
    },
    {
      "label": "a second parameter is refused",
      "input": "cars?lens=0x1111111111111111111111111111111111111111&x=1",
      "fold": "none",
      "expect": {
        "status": "INVALID",
        "rule": "unsupported-parameter"
      }
    },
    {
      "label": "a Lens naming one principal twice",
      "input": "cars?lens=0x1111111111111111111111111111111111111111,0x1111111111111111111111111111111111111111",
      "fold": "none",
      "expect": {
        "status": "INVALID",
        "rule": "bad-lens"
      }
    },
    {
      "label": "an empty Lens",
      "input": "cars?lens=",
      "fold": "none",
      "expect": {
        "status": "INVALID",
        "rule": "bad-lens"
      }
    },
    {
      "label": "a Lens of more than 64",
      "input": "cars?lens=0x0000000000000000000000000000000000000001,0x0000000000000000000000000000000000000002,0x0000000000000000000000000000000000000003,0x0000000000000000000000000000000000000004,0x0000000000000000000000000000000000000005,0x0000000000000000000000000000000000000006,0x0000000000000000000000000000000000000007,0x0000000000000000000000000000000000000008,0x0000000000000000000000000000000000000009,0x000000000000000000000000000000000000000a,0x000000000000000000000000000000000000000b,0x000000000000000000000000000000000000000c,0x000000000000000000000000000000000000000d,0x000000000000000000000000000000000000000e,0x000000000000000000000000000000000000000f,0x0000000000000000000000000000000000000010,0x0000000000000000000000000000000000000011,0x0000000000000000000000000000000000000012,0x0000000000000000000000000000000000000013,0x0000000000000000000000000000000000000014,0x0000000000000000000000000000000000000015,0x0000000000000000000000000000000000000016,0x0000000000000000000000000000000000000017,0x0000000000000000000000000000000000000018,0x0000000000000000000000000000000000000019,0x000000000000000000000000000000000000001a,0x000000000000000000000000000000000000001b,0x000000000000000000000000000000000000001c,0x000000000000000000000000000000000000001d,0x000000000000000000000000000000000000001e,0x000000000000000000000000000000000000001f,0x0000000000000000000000000000000000000020,0x0000000000000000000000000000000000000021,0x0000000000000000000000000000000000000022,0x0000000000000000000000000000000000000023,0x0000000000000000000000000000000000000024,0x0000000000000000000000000000000000000025,0x0000000000000000000000000000000000000026,0x0000000000000000000000000000000000000027,0x0000000000000000000000000000000000000028,0x0000000000000000000000000000000000000029,0x000000000000000000000000000000000000002a,0x000000000000000000000000000000000000002b,0x000000000000000000000000000000000000002c,0x000000000000000000000000000000000000002d,0x000000000000000000000000000000000000002e,0x000000000000000000000000000000000000002f,0x0000000000000000000000000000000000000030,0x0000000000000000000000000000000000000031,0x0000000000000000000000000000000000000032,0x0000000000000000000000000000000000000033,0x0000000000000000000000000000000000000034,0x0000000000000000000000000000000000000035,0x0000000000000000000000000000000000000036,0x0000000000000000000000000000000000000037,0x0000000000000000000000000000000000000038,0x0000000000000000000000000000000000000039,0x000000000000000000000000000000000000003a,0x000000000000000000000000000000000000003b,0x000000000000000000000000000000000000003c,0x000000000000000000000000000000000000003d,0x000000000000000000000000000000000000003e,0x000000000000000000000000000000000000003f,0x0000000000000000000000000000000000000040,0x0000000000000000000000000000000000000041",
      "fold": "none",
      "expect": {
        "status": "INVALID",
        "rule": "bad-lens"
      }
    },
    {
      "label": "a name in a Lens",
      "input": "cars?lens=alice.eth",
      "fold": "none",
      "expect": {
        "status": "INVALID",
        "rule": "lens-name-unsupported"
      }
    },
    {
      "label": "a revision takes no Lens",
      "input": "~efs/v/0xcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd?lens=0x1111111111111111111111111111111111111111",
      "fold": "none",
      "expect": {
        "status": "INVALID",
        "rule": "unsupported-parameter"
      }
    },
    {
      "label": "names after a folder's object link (a path from that folder, case kept)",
      "input": "~efs/o/0xfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfd/Photos/Cat.JPG",
      "fold": "none",
      "expect": {
        "status": "OK",
        "target": {
          "kind": "path",
          "folder": "0xfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfd",
          "names": ["Photos", "Cat.JPG"]
        },
        "canonical": "~efs/o/0xfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfd/Photos/Cat.JPG"
      }
    },
    {
      "label": "a path link in any hex case, an encoded name and one trailing slash",
      "input": "/~efs/o/0xFDFDFDFDFDFDFDFDFDFDFDFDFDFDFDFDFDFDFDFDFDFDFDFDFDFDFDFDFDFDFDFD/my%20photos/",
      "fold": "none",
      "expect": {
        "status": "OK",
        "target": {
          "kind": "path",
          "folder": "0xfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfd",
          "names": ["my photos"]
        },
        "canonical": "~efs/o/0xfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfd/my%20photos"
      }
    },
    {
      "label": "a path link, unicode name",
      "input": "~efs/o/0xfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfd/日本",
      "fold": "none",
      "expect": {
        "status": "OK",
        "target": {
          "kind": "path",
          "folder": "0xfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfd",
          "names": ["日本"]
        },
        "canonical": "~efs/o/0xfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfd/%E6%97%A5%E6%9C%AC"
      }
    },
    {
      "label": "a path link with a Lens",
      "input": "~efs/o/0xfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfd/photos?lens=0x1111111111111111111111111111111111111111",
      "fold": "none",
      "expect": {
        "status": "OK",
        "target": {
          "kind": "path",
          "folder": "0xfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfd",
          "names": ["photos"],
          "lens": {
            "principals": ["0x0000000000000000000000001111111111111111111111111111111111111111"]
          }
        },
        "canonical": "~efs/o/0xfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfd/photos?lens=0x1111111111111111111111111111111111111111"
      }
    },
    {
      "label": "an object link with no names stays an object link",
      "input": "~efs/o/0xfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfd/",
      "fold": "none",
      "expect": {
        "status": "OK",
        "target": {
          "kind": "object",
          "subject": "0xfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfd"
        },
        "canonical": "~efs/o/0xfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfd"
      }
    },
    {
      "label": "a path link's name .. refused",
      "input": "~efs/o/0xfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfd/photos/..",
      "fold": "none",
      "expect": {
        "status": "INVALID",
        "rule": "bad-name",
        "segment": 4,
        "detail": "dot-or-dotdot"
      }
    },
    {
      "label": "a path link's escaped slash refused",
      "input": "~efs/o/0xfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfd/a%2Fb",
      "fold": "none",
      "expect": {
        "status": "INVALID",
        "rule": "bad-name",
        "segment": 3,
        "detail": "excluded-character"
      }
    },
    {
      "label": "a path link's reserved name refused",
      "input": "~efs/o/0xfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfd/~efs",
      "fold": "none",
      "expect": {
        "status": "INVALID",
        "rule": "bad-name",
        "segment": 3,
        "detail": "reserved-prefix"
      }
    },
    {
      "label": "a path link's malformed escape",
      "input": "~efs/o/0xfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfd/%zz",
      "fold": "none",
      "expect": {
        "status": "INVALID",
        "rule": "bad-escape",
        "segment": 3
      }
    },
    {
      "label": "a path link's empty name",
      "input": "~efs/o/0xfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfdfd//a",
      "fold": "none",
      "expect": {
        "status": "INVALID",
        "rule": "empty-segment"
      }
    },
    {
      "label": "a revision link takes no names",
      "input": "~efs/v/0xcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd/extra",
      "fold": "none",
      "expect": {
        "status": "INVALID",
        "rule": "bad-id"
      }
    },
    {
      "label": "~root is not defined (the shared root has no named link)",
      "input": "~root/photos",
      "fold": "none",
      "expect": {
        "status": "INVALID",
        "rule": "reserved-name"
      }
    },
    {
      "label": "~home is never defined",
      "input": "~home/photos",
      "fold": "none",
      "expect": {
        "status": "INVALID",
        "rule": "reserved-name"
      }
    }
  ]
}
