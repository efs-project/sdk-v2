{
  "schema": "efs-sdk/vectors/links/1",
  "note": "The link grammar (tag model spec §5). `fold` names the fold step used: `none` (no fold given) or `ascii-test` (a stand-in for the tests only: lowercase A-Z and turn a run of spaces into one underscore; the real rule is efs/fold/1, still to be chosen). `expect` is the parse: status, then target and canonical, or rule, segment and detail (and, for bad-word, `word`: the segment as decoded, not folded, and `code`: the chain's own refusal code whenever the word grammar refused it; checkWord runs on what the fold produced, so `none` applies only the fold-independent rules). A `?lens=` parameter (1 to 64 principals, each once: a 20-byte address for an account, else a 32-byte principal id) is the only one defined, on every kind but revisions.",
  "cases": [
    {
      "label": "object link",
      "input": "~efs/o/0xabababababababababababababababababababababababababababababababab",
      "fold": "none",
      "expect": {
        "status": "OK",
        "target": {
          "kind": "object",
          "subject": "0xabababababababababababababababababababababababababababababababab"
        },
        "canonical": "~efs/o/0xabababababababababababababababababababababababababababababababab"
      }
    },
    {
      "label": "revision link",
      "input": "/~efs/v/0xCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCD",
      "fold": "none",
      "expect": {
        "status": "OK",
        "target": {
          "kind": "revision",
          "recordId": "0xcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd"
        },
        "canonical": "~efs/v/0xcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd"
      }
    },
    {
      "label": "other ~ segment is reserved",
      "input": "~tags/cars",
      "fold": "none",
      "expect": {
        "status": "INVALID",
        "rule": "reserved-name"
      }
    },
    {
      "label": "bare ~",
      "input": "~",
      "fold": "none",
      "expect": {
        "status": "INVALID",
        "rule": "reserved-name"
      }
    },
    {
      "label": "home root",
      "input": "0xAbCdEf0123456789aBcDeF0123456789AbCdEf01",
      "fold": "none",
      "expect": {
        "status": "OK",
        "target": {
          "kind": "home",
          "address": "0xabcdef0123456789abcdef0123456789abcdef01",
          "names": []
        },
        "canonical": "0xabcdef0123456789abcdef0123456789abcdef01"
      }
    },
    {
      "label": "home path keeps case",
      "input": "0xabcdef0123456789abcdef0123456789abcdef01/Photos/Cat.JPG",
      "fold": "ascii-test",
      "expect": {
        "status": "OK",
        "target": {
          "kind": "home",
          "address": "0xabcdef0123456789abcdef0123456789abcdef01",
          "names": ["Photos", "Cat.JPG"]
        },
        "canonical": "0xabcdef0123456789abcdef0123456789abcdef01/Photos/Cat.JPG"
      }
    },
    {
      "label": "home name with space, encoded",
      "input": "0xabcdef0123456789abcdef0123456789abcdef01/my%20photos",
      "fold": "none",
      "expect": {
        "status": "OK",
        "target": {
          "kind": "home",
          "address": "0xabcdef0123456789abcdef0123456789abcdef01",
          "names": ["my photos"]
        },
        "canonical": "0xabcdef0123456789abcdef0123456789abcdef01/my%20photos"
      }
    },
    {
      "label": "home name, unicode",
      "input": "0xabcdef0123456789abcdef0123456789abcdef01/日本",
      "fold": "none",
      "expect": {
        "status": "OK",
        "target": {
          "kind": "home",
          "address": "0xabcdef0123456789abcdef0123456789abcdef01",
          "names": ["日本"]
        },
        "canonical": "0xabcdef0123456789abcdef0123456789abcdef01/%E6%97%A5%E6%9C%AC"
      }
    },
    {
      "label": "home name .. refused",
      "input": "0xabcdef0123456789abcdef0123456789abcdef01/..",
      "fold": "none",
      "expect": {
        "status": "INVALID",
        "rule": "bad-name",
        "segment": 1,
        "detail": "trailing-dot"
      }
    },
    {
      "label": "home name with escaped slash refused",
      "input": "0xabcdef0123456789abcdef0123456789abcdef01/a%2Fb",
      "fold": "none",
      "expect": {
        "status": "INVALID",
        "rule": "bad-name",
        "segment": 1,
        "detail": "reserved-character"
      }
    },
    {
      "label": "home with a Lens",
