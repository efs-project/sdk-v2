{
  "name": "@efs/sdk",
  "version": "0.0.0",
  "private": true,
  "description": "EFS v2 SDK (pre-alpha: repository scaffold only; no SDK functionality yet)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/efs-project/sdk-v2.git",
    "directory": "packages/sdk"
  },
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "default": "./dist/web/index.js"
    },
    "./node": {
      "node": {
        "types": "./dist/node/index.d.ts",
        "default": "./dist/node/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../tools/clean.mjs dist && tsc -p tsconfig.json && tsc -p tsconfig.dom.json && tsc -p tsconfig.node.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.dom.json --noEmit && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@vitest/browser-playwright": "5.0.2",
    "playwright": "1.63.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
